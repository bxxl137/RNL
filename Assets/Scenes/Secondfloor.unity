--- !u!114 &1378181347
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1378181343}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 269b852a688184344b41020bd304d753, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  maskPanel: {fileID: 1288369528}
  hideMaskOnExit: 1
  targetText: {fileID: 287437126}
  lines:
  - text: "\nunity dont treat chinese....\nso if you r not english\nplease join yihetuang\uFF01\uFF01\uFF01\n"
    color: {r: 0, g: 0, b: 0, a: 0}
    gapAfter: 2
    typewriter: 1
    charsPerSecond: 10
  - text: 'You found a leaflet on the ground in front of your house

      Community
      faulty equipment repair hotline......

      (Write it down, it should come
      in handy)'
    color: {r: 0.8553459, g: 0.051105406, b: 0.051105406, a: 0}
    gapAfter: 3
    typewriter: 1
    charsPerSecond: 20
  - text: 'Sometime without being noticed

      this community seems to have lost
      the vibrancy and liveliness it used to have

      Everyone is occupied with
      their own lives, gradually neglecting the people and things around them

      Unattended
      piles of sundries, broken light bulbs that no one cares about

      It was
      only just now that I suddenly realized that I had long been caught up in this
      as well)

      Luckily, it''s not too late to notice this now

      I''ll
      call to report the corridor lights and street lamps for repair, then go to
      bed

      (Tomorrow will be a brand new day)'
    color: {r: 0.8128216, g: 0.85490197, b: 0.05098038, a: 0}
    gapAfter: 0
    typewriter: 1
    charsPerSecond: 50
  defaultCharsPerSecond: 22
  holdTime: 1.5
  onlyOnce: 1
